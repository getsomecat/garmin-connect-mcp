# Authentication: provide a session token, or both username and password.
GARMIN_SESSION_TOKEN=
# Alternative for systemd EnvironmentFile values containing quotes/newlines.
GARMIN_SESSION_TOKEN_B64=
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=

# global uses garmin.com; cn uses garmin.cn.
GARMIN_REGION=global

# Runtime tuning.
GARMIN_CACHE_TTL=300
GARMIN_CACHE_MAX_ENTRIES=100
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_BASE_DELAY_MS=1000
GARMIN_RETRY_MAX_DELAY_MS=30000
GARMIN_ACTIVITY_DETAIL=compact
GARMIN_LOG_LEVEL=info

# Transport. stdio is local; http is for a private reverse-proxied deployment.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100
MCP_HTTP_PATH=/mcp

# Optional legacy/static client access. Generate with: openssl rand -hex 32
# HTTP requires this token, the complete OAuth block below, or both.
MCP_BEARER_TOKEN=

# Single-user OAuth 2.1 for a private ChatGPT plugin.
MCP_PUBLIC_URL=https://garmin.example.com/mcp
# Generate with: npm run hash-oauth-password
MCP_OAUTH_PASSWORD_HASH=
MCP_OAUTH_STATE_FILE=/var/lib/garmin-connect-mcp/oauth-state.json
# The default is ChatGPT's stable OAuth callback. Comma-separate only if needed.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
MCP_OAUTH_ACCESS_TOKEN_TTL=3600
MCP_OAUTH_REFRESH_TOKEN_TTL=7776000
