# Authentication: provide a session token, or both username and password.
GARMIN_SESSION_TOKEN=
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=

# global uses garmin.com; cn uses garmin.cn.
GARMIN_REGION=global

# Runtime tuning.
GARMIN_CACHE_TTL=300
GARMIN_CACHE_MAX_ENTRIES=100
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_BASE_DELAY_MS=1000
GARMIN_RETRY_MAX_DELAY_MS=30000
GARMIN_ACTIVITY_DETAIL=compact
GARMIN_LOG_LEVEL=info
