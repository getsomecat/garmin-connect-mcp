# Recommended single-user authentication: a private, automatically refreshed DI session file.
# Keep GARMIN_USERNAME after export because the file is bound to its normalized hash.
GARMIN_USERNAME=you@example.com
# Optional absolute override. Default: ~/.config/garmin-connect-mcp/session.json
# For the supplied systemd unit use: /var/lib/garmin-connect-mcp/session.json
GARMIN_SESSION_TOKEN_FILE=
# Set only for the initial interactive export, then remove it.
GARMIN_PASSWORD=

# Legacy migration inputs. Prefer the private session file above.
GARMIN_SESSION_TOKEN=
# Alternative for systemd EnvironmentFile values containing quotes/newlines.
GARMIN_SESSION_TOKEN_B64=

# global uses garmin.com; cn uses garmin.cn.
GARMIN_REGION=global

# Runtime tuning.
GARMIN_CACHE_TTL=300
GARMIN_CACHE_MAX_ENTRIES=100
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_BASE_DELAY_MS=1000
GARMIN_RETRY_MAX_DELAY_MS=30000
GARMIN_ACTIVITY_DETAIL=compact
GARMIN_LOG_LEVEL=info

# Transport. stdio is local; http is for a private reverse-proxied deployment.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100
MCP_HTTP_PATH=/mcp

# Optional static client access. Generate with: openssl rand -hex 32
# HTTP requires this token, one complete OAuth option below, or both token + one OAuth option.
MCP_BEARER_TOKEN=

# Recommended private ChatGPT/Codex remote OAuth: Auth0. Uncomment this complete block.
# The audience must be the exact same canonical URL as MCP_PUBLIC_URL.
# MCP_PUBLIC_URL=https://garmin.example.com/mcp
# MCP_AUTH0_DOMAIN=your-tenant.us.auth0.com
# MCP_AUTH0_AUDIENCE=https://garmin.example.com/mcp
# Strongly recommended: comma-separated Auth0 user IDs allowed to reach this Garmin account.
# MCP_AUTH0_ALLOWED_SUBJECTS=auth0|your-user-id

# Built-in single-user OAuth fallback. Use only instead of Auth0, never together with it.
# MCP_PUBLIC_URL=https://garmin.example.com/mcp
# Generate with: npm run hash-oauth-password
# MCP_OAUTH_PASSWORD_HASH=scrypt$...
# MCP_OAUTH_STATE_FILE=/var/lib/garmin-connect-mcp/oauth-state.json
# The default is ChatGPT's stable OAuth callback. Comma-separate only if needed.
# MCP_OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# MCP_OAUTH_ACCESS_TOKEN_TTL=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL=7776000
